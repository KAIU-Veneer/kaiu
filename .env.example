# Google Apps Script web app URL that writes each submission to the Sheet.
# Server-only: this is read by api/contact.js and is never sent to the browser.
CONTACT_SHEET_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional. Comma-separated origins allowed to post to /api/contact.
# Leave unset to allow only the deployment's own origin.
# ALLOWED_ORIGINS=https://kaiu.com,https://www.kaiu.com
